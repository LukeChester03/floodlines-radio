<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runs the weekly gig hunt every Monday at 07:00 (local time).

  Set the two paths below to this checkout's functions/ directory and to your
  node binary (`which node`), then copy and load it:

    cp functions/scripts/gig-hunt.plist ~/Library/LaunchAgents/uk.floodlines.gig-hunt.plist
    launchctl load ~/Library/LaunchAgents/uk.floodlines.gig-hunt.plist

  Unload with `launchctl unload` on the same path. Output goes to /tmp/gig-hunt.log.
  `claude` must be on the PATH below and logged in; Firestore access uses
  Application Default Credentials (`gcloud auth application-default login`).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>uk.floodlines.gig-hunt</string>
  <key>WorkingDirectory</key>
  <string>/Users/YOU/_git/floodlines-radio/functions</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/npm</string>
    <string>run</string>
    <string>gig-hunt</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/YOU/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/gig-hunt.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/gig-hunt.log</string>
</dict>
</plist>
