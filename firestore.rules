rules_version = '2';
// Only the band's shared login can read or write the campaign data.
// The test login test@test.com is read-only, for screenshots (ui-evidence); it can never write.
service cloud.firestore {
  match /databases/{database}/documents {
    function isBand() {
      return request.auth != null && request.auth.token.email == 'floodlinesbanduk@gmail.com';
    }
    function isTester() {
      return request.auth != null && request.auth.token.email == 'test@test.com';
    }
    match /{collection}/{id} {
      allow read: if (isBand() || isTester()) && collection in ['stations', 'songs', 'settings'];
      allow write: if isBand() && collection in ['stations', 'songs', 'settings'];
    }
    // Clients only ever queue (review) or approve; the server owns every other state
    match /sendlist/{id} {
      allow read: if isBand() || isTester();
      allow delete: if isBand();
      allow create, update: if isBand() && request.resource.data.get('state', 'review') in ['review', 'approved'];
    }
    // Gigs are written by the server; the band only reads them and records its decision
    match /gigs/{id} {
      allow read: if isBand() || isTester();
      allow update: if isBand() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['decision', 'decidedAt']);
    }
    // Festivals are loaded by the server; the band only reads them and records its decision
    match /festivals/{id} {
      allow read: if isBand() || isTester();
      allow update: if isBand() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['decision', 'decidedAt']);
    }
    match /gigstatus/{id} {
      allow read: if isBand() || isTester();
    }
    // Gmail connection status is written by the server only
    match /gmail/status {
      allow read: if isBand() || isTester();
    }
    // Replies are written by the server (Admin); the band only records its decision
    match /replies/{id} {
      allow read: if isBand() || isTester();
      allow update: if isBand() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['decision', 'decidedAt']);
    }
    // The weekly run status is written by the server (Admin) only
    match /gigstatus/last {
      allow read: if isBand() || isTester();
    }
    // Send records are written by the server (Admin) only
    match /sends/{id} {
      allow read: if isBand() || isTester();
    }
  }
}
