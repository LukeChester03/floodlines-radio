rules_version = '2';
// Only the band's shared login can read or write the campaign data.
service cloud.firestore {
  match /databases/{database}/documents {
    function isBand() {
      return request.auth != null && request.auth.token.email == 'floodlinesbanduk@gmail.com';
    }
    match /{collection}/{id} {
      allow read, write: if isBand() && collection in ['stations', 'songs', 'settings'];
    }
    // Clients only ever queue (review) or approve; the server owns every other state
    match /sendlist/{id} {
      allow read, delete: if isBand();
      allow create, update: if isBand() && request.resource.data.get('state', 'review') in ['review', 'approved'];
    }
    // Gmail connection status is written by the server only
    match /gmail/status {
      allow read: if isBand();
    }
    // Send records are written by the server (Admin) only
    match /sends/{id} {
      allow read: if isBand();
    }
  }
}
