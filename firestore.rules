rules_version = '2';
// Only the band's shared login can read or write the campaign data.
service cloud.firestore {
  match /databases/{database}/documents {
    function isBand() {
      return request.auth != null && request.auth.token.email == 'floodlinesbanduk@gmail.com';
    }
    match /{collection}/{id} {
      allow read, write: if isBand() && collection in ['stations', 'songs', 'sendlist', 'settings'];
    }
  }
}
